{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zumbi-blocks",
  "account_id": "c7d9cc74b0354c939de1012aebe158cb",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "zumbi-blocks-classic.vitosenic.com", "custom_domain": true }],
  "assets": {
    "directory": "../game/Build/WebGL",
    "binding": "ASSETS",
    // The Worker handles /Build/* (adds Content-Encoding for the Unity .br files), /api/* and /ws/*.
    "run_worker_first": ["/Build/*", "/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  // Phase 5 leaderboards + game counts (docs/LEADERBOARD.md). Schema: server/migrations, apply with
  //   npx wrangler d1 migrations apply zumbi-blocks --remote   (and --local for wrangler dev)
  // The solo start token secret is a wrangler secret: npx wrangler secret put ZB_SECRET
  "d1_databases": [{ "binding": "DB", "database_name": "zumbi-blocks", "database_id": "a7ec0cb0-c34a-4e20-a1ff-5f284b4f8c54", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
